# Optional: set a complete SQLAlchemy URL. When set, it takes precedence.
# DATABASE_URL=mysql+pymysql://report_user:change-me@localhost:3306/generate_report

# Supported values: mysql or mssql.
DB_DIALECT=mssql
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=generate_report
DB_USER=sa
DB_PASSWORD=replace-with-a-strong-local-password

# Used only when DB_DIALECT=mssql. Install the matching ODBC driver on your machine.
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Set true only for a trusted local self-signed certificate; keep false for shared/production servers.
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Application access tokens: use a long, random value; never commit a real secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Active Directory (AGILE). The DC is on the company network: connect to the office network/VPN first.
# Transport: StartTLS on 389 (or LDAPS on 636 with LDAP_USE_SSL=true) with certificate validation.
# NTLM session encryption on plain 389 is used only if the installed ldap3 implements it (2.9.1 does not),
# otherwise the app refuses to connect rather than sending directory traffic unencrypted.
# For certificate validation LDAP_HOST must be the DC's DNS name on its certificate, not an IP address.
LDAP_ENABLED=false
LDAP_HOST=dc01.agile.local
LDAP_PORT=389
LDAP_BASE_DN=DC=agile,DC=local
LDAP_DOMAIN=agile.local
LDAP_NETBIOS_DOMAIN=AGILE
LDAP_AUTH_METHOD=NTLM
LDAP_NTLM_SESSION_ENCRYPTION=true
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_SSL=false
LDAP_START_TLS=true
LDAP_CA_CERT_FILE=
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_SEARCH_TIMEOUT_SECONDS=5
LDAP_NESTED_GROUPS=true
LDAP_GROUP_SIZE_LIMIT=500
LDAP_ALLOWED_GROUPS=
# Example: LDAP_ALLOWED_GROUPS=Report Users;Scheduler Users
# Example: LDAP_GROUP_PERMISSIONS=Report Users=reports:read,reports:write;Scheduler Users=scheduler:run
LDAP_GROUP_PERMISSIONS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Local proof-of-concept authentication. Never set mock mode in production.
AUTH_MODE=mock
MOCK_TESTEXPERT_PASSWORD=replace-with-a-local-demo-password
GENERATED_REPORTS_DIR=../generated_reports
UPLOADS_DIR=uploads
MAX_REPORT_ROWS=1000
MAX_UPLOAD_BYTES=16384
MAX_EMAIL_RECIPIENTS=10

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
